<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="2dp"
    android:paddingEnd="0dp">

    <!-- Left & Middle: Checkbox + Task Text (Tap to check off / untick) -->
    <LinearLayout
        android:id="@+id/widget_todo_item_toggle_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingEnd="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/widget_todo_item_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_checkbox_unchecked"
            android:contentDescription="Toggle task" />

        <TextView
            android:id="@+id/widget_todo_item_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Task item"
            android:textColor="#1C2B36"
            android:textSize="13.5sp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Right: Delete (×) button directly inside widget row -->
    <ImageView
        android:id="@+id/widget_todo_item_delete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="7dp"
        android:src="@drawable/ic_widget_delete"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Delete task" />

</LinearLayout>
