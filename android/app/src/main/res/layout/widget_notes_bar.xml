<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bar_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fill_shape"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_bar_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_border_shape"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_notes_bar_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_notes_bar_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes &amp; Ideas"
            android:textColor="#1C2B36"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_bar_btn_new"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_circle_button"
        android:gravity="center"
        android:contentDescription="New Note">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Add" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
