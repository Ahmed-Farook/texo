<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF6EF"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/config_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="texō"
        android:textColor="#213A50"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Select a Checklist"
        android:textColor="#1C2B36"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Choose which checklist to display on this widget."
        android:textColor="#5A6E82"
        android:textSize="13sp" />

    <View
        android:id="@+id/config_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="#DFD3C0" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/config_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/config_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No checklists found in texō yet.\nCreate a checklist first, then add this widget."
            android:textColor="#5A6E82"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_open_texo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/widget_btn_action_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Open texō"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Checklist ListView -->
    <ListView
        android:id="@+id/config_checklist_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DFD3C0"
        android:dividerHeight="1dp" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btn_cancel_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#5A6E82"
        android:backgroundTint="#E5DCCB" />

</LinearLayout>
