<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_quick_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fill_shape"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/widget_quick_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_border_shape"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_quick_note_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

    <ImageView
        android:id="@+id/widget_quick_note_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_circle_button"
        android:padding="10dp"
        android:src="@drawable/ic_widget_add"
        android:contentDescription="New Note" />

    <TextView
        android:id="@+id/widget_quick_note_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="New Note"
        android:textColor="#1C2B36"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
